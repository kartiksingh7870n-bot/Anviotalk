# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (prefixed with VITE_ for client-side access in Vite)
VITE_FIREBASE_API_KEY="AIzaSyBR9e8eLDsyr5cHhwkcanRTbPqqjfGBBHU"
VITE_FIREBASE_AUTH_DOMAIN="anvio-talk.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="anvio-talk"
VITE_FIREBASE_STORAGE_BUCKET="anvio-talk.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="1059844371114"
VITE_FIREBASE_APP_ID="1:1059844371114:web:0ab0d9be1f9327274216d3"
VITE_FIREBASE_MEASUREMENT_ID="G-YGJ3SFH5NK"

# PayPal Payouts API Configuration
# Get credentials from PayPal Developer Dashboard (https://developer.paypal.com) -> REST API Apps -> Create App
# PAYPAL_MODE options: 'sandbox' (default for testing) or 'live' (for real production payouts)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"

# Firebase Admin SDK Service Account JSON (Required on server for admin actions, reports moderation & FCM push notifications)
# Accepts either format:
# Option A: Single-line minified JSON string:
#   Generate with: cat service-account.json | jq -c .
#   Example: FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"anvio-talk","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@anvio-talk.iam.gserviceaccount.com",...}'
# Option B: Base64-encoded JSON string:
#   Generate with: cat service-account.json | base64 | tr -d '\n'
#   Example: FIREBASE_SERVICE_ACCOUNT_JSON="eyJ0eXBlIjoic2VydmljZV9hY2NvdW50IiwicHJvamVjdF9pZCI6ImFudmlvLXRhbGsiLC4uLn0="
FIREBASE_SERVICE_ACCOUNT_JSON=
